{
  "uid": "openmythos-serving",
  "title": "OpenMythos Serving",
  "tags": [
    "openmythos"
  ],
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Requests per Second",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(openmythos_requests_total[1m])",
          "legendFormat": "{{endpoint}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "P50 / P99 Latency (s)",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(openmythos_request_latency_seconds_bucket[5m]))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.99, rate(openmythos_request_latency_seconds_bucket[5m]))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tokens/sec",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "rate(openmythos_tokens_generated_total[1m])"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active Requests",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "targets": [
        {
          "expr": "openmythos_active_requests"
        }
      ]
    },
    {
      "id": 5,
      "title": "GPU Util %",
      "type": "gauge",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "openmythos_gpu_utilization_percent"
        }
      ]
    },
    {
      "id": 6,
      "title": "Error Rate",
      "type": "graph",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "targets": [
        {
          "expr": "rate(openmythos_requests_total{status='error'}[5m])/rate(openmythos_requests_total[5m])"
        }
      ]
    }
  ]
}